# Shared by all five services. Copy to .env.
# The keys below are Hardhat's PUBLIC default test accounts — never use them on a real network.

DATABASE_URL=postgres://localhost:5433/coldchainsg
RPC_URL=http://127.0.0.1:8545
CHAIN_NETWORK=localhost
FRONTEND_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Service wallets (Hardhat accounts #0, #1, #2, #3)
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ORACLE_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
CERTIFIER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# Sensor gateway key: funds each registered sensor's device key and derives it
SENSOR_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
