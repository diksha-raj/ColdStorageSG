{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run test*)",
      "Bash(npx hardhat test *)"
    ],
    "ask": [
      "Bash(npm run deploy:sepolia *)",
      "Bash(npx hardhat * --network sepolia*)",
      "Bash(git push *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(/.env)"
    ]
  }
}
